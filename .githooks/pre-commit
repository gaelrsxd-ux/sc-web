#!/bin/sh
# Barreras que se ejecutan antes de cada commit.
# Se activa una vez por clon con:  git config core.hooksPath .githooks
#
# Son cuatro y las cuatro son baratas. Si alguna tarda, el problema es la
# barrera, no el commit: ninguna debe pasar de un segundo.

# 1 · Nada con pinta de secreto entra en el repositorio.
node tools/scan-secretos.mjs || exit 1

# 2 · Los hashes de la CSP cuadran con el HTML.
#     Sin esto, editar un script en línea y publicar deja la web SIN JavaScript
#     en producción, de forma silenciosa: el navegador bloquea los tres bloques
#     por huella caducada y no hay error visible en ningún sitio. La herramienta
#     existía desde el principio; lo que faltaba era que algo la ejecutara.
#
#     ⚠ LEE DEL DISCO, NO DEL ÍNDICE. A diferencia del escáner de secretos —que
#     usa `git show :archivo`—, csp-hashes.mjs abre los ficheros con readFileSync.
#     Con un commit parcial (`git add -p`, o índice y árbol divergentes) puede
#     dar verde sobre un HTML que no es el que se está guardando. Es la mejor
#     aproximación barata que hay aquí; la red de verdad es el CI, que trabaja
#     sobre el árbol ya commiteado y por tanto no tiene esta ambigüedad.
# La huella del contenido en el enlace de cada hoja de estilo. Va ANTES de la
# CSP porque toca el mismo HTML que ésta firma.
node tools/assets.mjs --check || exit 1

node tools/csp-hashes.mjs --check || exit 1

# 3 · Ningún documento legal debería salir a producción con marcadores de
#     relleno. AHORA BLOQUEA. Durante un tiempo sólo avisaba, porque los datos
#     que faltaban —responsables, domicilio y los dos encargados— sólo los tenía
#     el titular del negocio, y una barrera que nadie puede satisfacer se
#     desactiva con --no-verify a la tercera vez. Ya están rellenos, así que la
#     barrera es satisfacible y muerde: ningún documento legal a medias vuelve a
#     publicarse por descuido.
if grep -rl "POR COMPLETAR" "Kimi_Agent_Web 3D Optimizada/app" 2>/dev/null | grep -q .; then
  echo "pre-commit: hay marcadores «POR COMPLETAR» en documentos legales publicados."
  echo "            Un aviso de privacidad a medias no puede salir a producción."
  grep -rn "POR COMPLETAR" "Kimi_Agent_Web 3D Optimizada/app" 2>/dev/null | sed 's/^/            /'
  exit 1
fi

# 4 · Los precios del HTML salen de la tabla y no de la memoria de nadie.
#     Cada precio vivía escrito en tres sitios dentro de cada una de las once
#     filas, más el precio de cabecera y la línea de envío. Editar a mano y que
#     una de las treinta y tres copias no coincida es cuestión de tiempo, y el
#     fallo que produce es de los peores de esta web: la página enseña un precio
#     y el WhatsApp que se abre pide otro. Lo descubre el cliente, al pedir.
node tools/precios.mjs --check || exit 1
