# Cabeceras de seguridad para Cloudflare Pages.
# Este archivo no se publica como página: Pages lo lee al desplegar y aplica
# estas cabeceras a las respuestas. Los cuatro primeros valores son los que
# cualquier revisión de seguridad busca; la política de contenido es la que de
# verdad limita el daño si algún día se cuela código ajeno en la página.

/*
  # Obliga a que el navegador use HTTPS durante un año, aunque alguien escriba
  # la dirección con http:// o la intercepte por el camino.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Impide que el navegador "adivine" el tipo de un archivo y lo ejecute como
  # algo que no es.
  X-Content-Type-Options: nosniff
  # Nadie puede meter esta web dentro de un iframe suyo para superponer botones
  # invisibles encima. Es la defensa contra el secuestro de clics.
  X-Frame-Options: DENY
  # Al salir hacia otro sitio se envía sólo el dominio de origen, nunca la ruta
  # ni los parámetros.
  Referrer-Policy: strict-origin-when-cross-origin
  # La web no necesita cámara, micrófono, ubicación ni pagos: se renuncia a
  # todo ello de forma explícita para que ningún script pueda pedirlo.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # Aísla esta pestaña de cualquier ventana que la abra o que ella abra. Con
  # X-Frame-Options ya nadie puede meterla en un iframe; esto cierra la otra
  # mitad, la de window.opener, y de paso habilita el aislamiento de origen que
  # protege de la familia Spectre.
  Cross-Origin-Opener-Policy: same-origin
  # Ningún otro sitio puede incrustar los recursos de este como si fueran suyos.
  # No rompe nada: las tipografías de Google se cargan como documento propio y
  # esta directiva sólo gobierna quién puede incrustarnos a NOSOTROS.
  Cross-Origin-Resource-Policy: same-origin
  # Política de contenido. Cada origen listado está aquí porque la web lo usa de
  # verdad: las tipografías de Google y el Worker del diagnóstico. Todo lo demás
  # queda bloqueado.
  #
  # La directiva de scripts va con HASHES, no con 'unsafe-inline'. El JS sigue
  # viviendo dentro del HTML —que es lo que hace que la página cargue en una
  # sola petición—, pero ahora cada bloque está autorizado por su huella exacta.
  # Con 'unsafe-inline' la política no servía de nada contra un XSS, y esta es
  # justo la web que muestra texto traído de sitios de terceros por el
  # diagnóstico.
  #
  # LAS HUELLAS CADUCAN AL EDITAR CUALQUIER SCRIPT DEL HTML. No se escriben a
  # mano: las genera  node tools/csp-hashes.mjs
  # Antes de desplegar,  node tools/csp-hashes.mjs --check  falla si están
  # desfasadas; sin esa comprobación la web se publicaría sin JavaScript.
  #
  # Se calculan sobre el contenido con saltos de línea LF, no CRLF: el navegador
  # normaliza los saltos al parsear el HTML, así que un hash calculado sobre el
  # archivo tal cual está en disco (CRLF, en Windows) lo rechaza el navegador.
  #
  # style-src conserva 'unsafe-inline' a propósito: el riesgo de una inyección de
  # estilos es muy inferior al de ejecución de código, y los estilos inline están
  # repartidos por todo el marcado, no en tres bloques.
  #
  # Turnstile añade EXACTAMENTE dos valores, que son los que documenta
  # Cloudflare en su página de CSP: `script-src` para cargar api.js y
  # `frame-src` para el iframe del widget. Nada más. La doc menciona además
  # `connect-src 'self'`, pero sólo para el modo pre-clearance, que no usamos, y
  # 'self' ya está.
  # No hace falta unsafe-inline: Turnstile no exige estilos ni scripts en línea,
  # y los scripts propios siguen autorizados por su huella.
  #
  # connect-src lleva DOS destinos y ninguno de adorno:
  #   audit.sycsolutions.company  — el Worker del diagnóstico.
  #   app.sycsolutions.company    — el gateway al que envía el formulario de
  #     contacto. Sin este origen el navegador corta el fetch antes de que salga
  #     un byte, y lo único que se ve es un error de CSP en la consola: el
  #     formulario parece roto sin motivo aparente. Si el gateway cambia de
  #     dominio hay que tocarlo aquí Y en GATEWAY, en el script de index.html.
  #
  # ⚠ form-action LLEVA LOS DOMINIOS DE MERCADO PAGO, Y NO SOBRAN. Safari
  #   aplica form-action también al DESTINO DE LA REDIRECCIÓN, no sólo a
  #   dónde apunta el formulario; Chrome no. El botón de pagar envía a
  #   pagos.sycsolutions.company, que responde un 303 hacia Mercado Pago:
  #   sin esos dos dominios aquí, Safari deja salir el envío y BLOQUEA EL
  #   SALTO, en silencio y sin error visible. El comprador ve girar la
  #   ruedita y quedarse igual. Se descubrió así, en producción, con los
  #   once botones publicados y ninguno funcionando en iPhone.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-oASLDhF/wrdjgKb1jWSEHw+P3icd6tVkULphaCwYYfo=' 'sha256-1T5SBsWvrPPDQwNjMt5VkweRCo4IeUm/Qp1jaw1rXmo=' 'sha256-1YcHTp+94yo0yNQ3xn1XoKiiMVR/bXCRxmKc54PAPuY=' 'sha256-1UYHlp59ZSbXGgl45NvjIlExLrn+hYPj86ch3xrjNY0=' 'sha256-0Uxg2URn/CV/xGD19Tlv2IJzxBpvEaY8AwX1D1BBt60=' 'sha256-MkME9gFQvCGVHmcxRu/glXmAXp0cNDGa7M+WhbYlnSA=' 'sha256-Y4boyP6Av9BvsLVjaTtxEYRS/zbQHeAZ1FBrFEHa2jM=' 'sha256-yI4Pz7lIGpDH35HG9wvKAI6ZC4R1sKo+FWHkzUvLDGs=' 'sha256-FlxEzcscs0/Mjoy+dFQvewndZ2k8LPSg7r3LyS6hQls='; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://audit.sycsolutions.company https://app.sycsolutions.company; form-action 'self' https://pagos.sycsolutions.company https://www.mercadopago.com.mx https://www.mercadopago.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

