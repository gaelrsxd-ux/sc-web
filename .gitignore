# Skills de agentes: ~700 KB de terceros, regenerables con
#   npx skills add higgsfield-ai/skills
# Lo que se versiona es skills-lock.json, no los archivos.
.agents/

# Symlinks a .agents/skills/ — Git en Windows los maneja mal
.claude/skills/

# Config local de Claude Code (permisos de esta máquina)
.claude/settings.local.json

# Rutas de servidores de prueba: apuntan a directorios temporales que solo
# existen en la sesión que los creó, así que no sirven en otra máquina.
.claude/launch.json

# Caché de Wrangler. Incluye wrangler-account.json, que guarda la cuenta de
# Cloudflare: no tiene por qué acabar en el repositorio.
.wrangler/

# Secretos locales. Hasta ahora la única defensa contra un .env era el hook de
# pre-commit, que se salta con --no-verify; y .dev.vars —que es justo donde
# wrangler dev lee los secretos locales, y por tanto donde va a acabar
# SAL_LIMITE al trabajar en local— no lo cubría nadie.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Material criptográfico suelto.
*.pem
*.key
*.p12
*.pfx
